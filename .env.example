# PostgreSQL connection string, e.g. from Supabase, Neon, or a local Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/padel"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-string"

# .env
AUTH_URL="http://your-server-ip:3011"     # or http://your-domain.id:3011
AUTH_TRUST_HOST=true

# Where uploaded images (news covers, club logos) are stored on disk. Must be
# a path outside the Next.js build output that survives redeploys — the
# default (./uploads next to the app) is fine as long as you don't delete the
# project directory on each deploy. Served back out via /api/uploads/[...path].
UPLOAD_DIR="./uploads"